        CREATE TABLE [dw_oysterlake].[dbo_silver].[silver_fct_card_transactions__dbt_tmp]
        
        AS 

with bronze_transactions as (
    select * from [dw_oysterlake].[dbo_bronze].[bronze_transaction]
),

dim_cards as (
    select * from [dw_oysterlake].[dbo_silver].[silver_dim_debit_cards]
),

dim_customers_accounts as (
    select * from [dw_oysterlake].[dbo_silver].[silver_dim_customer]
),

dim_date as (
    select * from [dw_oysterlake].[dbo_silver].[silver_dim_date]
),

fact_joins as (
    select
        -- Natural Key
        t.transaction_id,

        -- Dimension Keys (Surrogate / Foreign Keys)
        coalesce(d.date_key, -1) as transaction_date_key,
        coalesce(c.card_id, -1) as card_key,
        coalesce(ca.customer_id, -1) as customer_key,
        coalesce(ca.account_id, -1) as account_key,

        -- Degenerate Dimensions / Attributes
        t.counterparty_name,
        t.transaction_status,

        -- Facts / Measures
        t.transaction_amount,
        t.transaction_at

    from bronze_transactions t
    -- Join Card Dimension to get the card reference and link to customer
    left join dim_cards c 
        on t.card_id = c.card_id
    
    -- Join Customer/Account Dimension using the customer_id derived from the card
    left join dim_customers_accounts ca 
        on c.customer_id = ca.customer_id

    -- Join Date Dimension by casting the timestamp to date matches
    left join dim_date d 
        on cast(t.transaction_at as date) = d.date_actual
)

select * from fact_joins



    

  
