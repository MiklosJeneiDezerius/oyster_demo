        CREATE TABLE [dw_oysterlake].[dbo_silver].[silver_dim_debit_cards__dbt_tmp]
        
        AS 

with raw_cards as (
    select * from [dw_oysterlake].[dbo_bronze].[bronze_debitcard]
)

select
    CardID as card_id, 
    UserID as customer_id,
    CardNumberMasked as card_number_masked, 
    CardStatus as card_status, 
    SpendingLimitUSD as spending_limit_usd, 
    ExpiryDate as expiry_date
from raw_cards

    

  
  
