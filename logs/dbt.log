        CREATE TABLE [dw_oysterlake].[dbo_silver].[silver_dim_customers__dbt_tmp]
        
        AS SELECT 
    
    lower(convert(varchar(50), hashbytes('md5', coalesce(convert(varchar(max), coalesce(cast(customer_id as VARCHAR(MAX)), '_dbt_utils_surrogate_key_null_')), '')), 2))
 as customer_sk -- Fix: Explicitly prepend dbt_utils.
    ,CAST([CustomerID] AS VARCHAR(50)) as customer_id
    ,CAST([FirstName] AS VARCHAR(100)) as first_name
    ,CAST([LastName] AS VARCHAR(100)) as last_name
    ,CAST([TaxID] AS VARCHAR(20)) as tax_id 
    ,CAST([CustomerType] AS VARCHAR(50)) as customer_type
    ,CAST([DoB] AS DATE) as date_of_birth
FROM [dw_oysterlake].[dbo_bronze].[bronze_customers]

    

  
  
