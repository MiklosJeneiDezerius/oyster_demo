        CREATE TABLE [dw_oysterlake].[dbo_gold].[gold_dim_cards__dbt_tmp]
        
        AS SELECT 
    
    lower(convert(varchar(50), hashbytes('md5', coalesce(convert(varchar(max), concat(coalesce(cast(card_id as VARCHAR(MAX)), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(dbt_valid_from as VARCHAR(MAX)), '_dbt_utils_surrogate_key_null_'))), '')), 2))
 as card_sk -- Fix: Explicitly prepend dbt_utils.
