        CREATE TABLE [dw_oysterlake].[dbo_silver].[silver_dim_customer__dbt_tmp]
        
        AS /*
it is possible to denormalize customer and account data into a single view for 
easier analysis because it is one-one-one relation*/
with customers as (select * from [dw_oysterlake].[dbo_bronze].[bronze_customer]),
     accounts as (select * from [dw_oysterlake].[dbo_bronze].[bronze_account])
select c.CustomerID, c.FullName, c.CustomerType, a.AccountID, a.AccountNumber, a.AccountType as account_type, a.CurrencyCode as currency_code
from customers c left join accounts a on c.CustomerID = a.CustomerID

    

  
  
