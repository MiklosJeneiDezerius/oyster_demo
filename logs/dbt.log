        CREATE TABLE [dw_oysterlake].[dbo_gold].[gold_fact_transactions__dbt_tmp]
        
        AS with base_transactions as (
    SELECT 
        CAST([TransactionID] AS VARCHAR(50)) as transaction_id
        ,CAST([CardID] AS VARCHAR(50)) as card_id
        ,CAST([Amount] AS DECIMAL(18,4)) as amount
        ,CAST([Timestamp] AS DATETIME2(7)) as transaction_timestamp -- Fix 1: Added precision (7) to resolve SQL Server error
        ,CAST([Counterparty] AS VARCHAR(255)) as counterparty
        ,CAST([Status] AS VARCHAR(20)) as transaction_status
    FROM [lh_oysterlake].[oyster].[ld_oys_transaction_ledger.csv]
    WHERE [Status] = 'approved'
),

rolling_spend_calculation as (
    select
        t.transaction_id
        ,t.card_id
        ,t.amount
        ,t.transaction_timestamp
        ,t.counterparty
        ,t.transaction_status
        -- Fix 2: Changed ROWS to RANGE with a true 30-day time definition
        ,SUM(t.amount) OVER (
            PARTITION BY t.card_id 
            ORDER BY CAST(t.transaction_timestamp AS DATE)
            RANGE BETWEEN INTERVAL 30 DAY PRECEDING AND CURRENT ROW
         ) as rolling_30_day_spend
    from base_transactions t
)

select
    
    lower(convert(varchar(50), hashbytes('md5', coalesce(convert(varchar(max), coalesce(cast(r.transaction_id as VARCHAR(MAX)), '_dbt_utils_surrogate_key_null_')), '')), 2))
 as transaction_pk
    ,c.card_sk as card_fk 
    ,r.transaction_id
    ,r.amount
    ,r.transaction_timestamp
    ,r.counterparty
    ,r.transaction_status
    ,r.rolling_30_day_spend
    ,case 
        when r.rolling_30_day_spend < 2000 then 'Standard Tier'
        when r.rolling_30_day_spend >= 2000 and r.rolling_30_day_spend <= 5000 then 'Gold Tier'
        else 'Platinum Tier'
     end as computed_spending_tier
from rolling_spend_calculation r
left join [dw_oysterlake].[dbo_gold].[gold_dim_cards] c 
    on r.card_id = c.card_id
    and r.transaction_timestamp >= c.valid_from 
    and r.transaction_timestamp < c.valid_to

    

  
  
