        CREATE TABLE [dw_oysterlake].[dbo].[snap_silver_debit_cards__dbt_tmp]
        
        AS 

    with snapshot_query as (
        select * from [dw_oysterlake].[dbo].[snap_silver_debit_cards_snapshot_staging_temp_view]
    ),
    snapshotted_data as (
        select *,
        
    
        card_id as dbt_unique_key
    

        from [dw_oysterlake].[dbo].[snap_silver_debit_cards]
        where
        
            dbt_valid_to is null
        ),
    insertions_source_data as (
        select *,
        
    
        card_id as dbt_unique_key
    
,
        
    CAST(SYSDATETIME() AS DATETIME2(6))
 as dbt_updated_at,
        
    CAST(SYSDATETIME() AS DATETIME2(6))
 as dbt_valid_from,
        
  
  coalesce(nullif(
    CAST(SYSDATETIME() AS DATETIME2(6))
, 
    CAST(SYSDATETIME() AS DATETIME2(6))
), null)
  as dbt_valid_to
,
        
    CONVERT(VARCHAR(32), HashBytes('MD5', 
        coalesce(cast(card_id as varchar(max)), '')  + '|' + 
    
        coalesce(cast(
    CAST(SYSDATETIME() AS DATETIME2(6))
 as varchar(max)), '') 
    ), 2)
 as dbt_scd_id
        from snapshot_query
    ),
    updates_source_data as (
        select *,
        
    
        card_id as dbt_unique_key
    
,
        
    CAST(SYSDATETIME() AS DATETIME2(6))
 as dbt_updated_at,
        
    CAST(SYSDATETIME() AS DATETIME2(6))
 as dbt_valid_from,
        
    CAST(SYSDATETIME() AS DATETIME2(6))
 as dbt_valid_to
        from snapshot_query
    ),
        deletes_source_data as (
            select *, 
    
        card_id as dbt_unique_key
    

            from snapshot_query
        ),
    
    insertions as (
        select 'insert' as dbt_change_type, source_data.*
        from insertions_source_data as source_data
        left outer join snapshotted_data
            on 
    
        snapshotted_data.dbt_unique_key = source_data.dbt_unique_key
    

            where 
    
        snapshotted_data.dbt_unique_key is null
    

            or (
    
        snapshotted_data.dbt_unique_key is not null
    
 and ((snapshotted_data.[card_tier] != source_data.[card_tier]
        or
        (
            ((snapshotted_data.[card_tier] is null) and not (source_data.[card_tier] is null))
            or
            ((not snapshotted_data.[card_tier] is null) and (source_data.[card_tier] is null))
        ) or snapshotted_data.[card_status] != source_data.[card_status]
        or
        (
            ((snapshotted_data.[card_status] is null) and not (source_data.[card_status] is null))
            or
            ((not snapshotted_data.[card_status] is null) and (source_data.[card_status] is null))
        ) or snapshotted_data.[expiry_date] != source_data.[expiry_date]
        or
        (
            ((snapshotted_data.[expiry_date] is null) and not (source_data.[expiry_date] is null))
            or
            ((not snapshotted_data.[expiry_date] is null) and (source_data.[expiry_date] is null))
        ))))
    ),
    updates as (
        select 'update' as dbt_change_type, source_data.*,
        snapshotted_data.dbt_scd_id
        from updates_source_data as source_data
        join snapshotted_data
        on 
    
        snapshotted_data.dbt_unique_key = source_data.dbt_unique_key
    

        where ((snapshotted_data.[card_tier] != source_data.[card_tier]
        or
        (
            ((snapshotted_data.[card_tier] is null) and not (source_data.[card_tier] is null))
            or
            ((not snapshotted_data.[card_tier] is null) and (source_data.[card_tier] is null))
        ) or snapshotted_data.[card_status] != source_data.[card_status]
        or
        (
            ((snapshotted_data.[card_status] is null) and not (source_data.[card_status] is null))
            or
            ((not snapshotted_data.[card_status] is null) and (source_data.[card_status] is null))
        ) or snapshotted_data.[expiry_date] != source_data.[expiry_date]
        or
        (
            ((snapshotted_data.[expiry_date] is null) and not (source_data.[expiry_date] is null))
            or
            ((not snapshotted_data.[expiry_date] is null) and (source_data.[expiry_date] is null))
        )))
    )
        ,
        deletes as (
            select 'delete' as dbt_change_type,
            source_data.*,
            
    CAST(SYSDATETIME() AS DATETIME2(6))
 as dbt_valid_from,
            
    CAST(SYSDATETIME() AS DATETIME2(6))
 as dbt_updated_at,
            
    CAST(SYSDATETIME() AS DATETIME2(6))
 as dbt_valid_to,
            snapshotted_data.dbt_scd_id
            from snapshotted_data
            left join deletes_source_data as source_data
            on 
    
        snapshotted_data.dbt_unique_key = source_data.dbt_unique_key
    

            where 
    
        source_data.dbt_unique_key is null
    

        )
    select * from insertions
    union all
    select * from updates
        union all
        select * from deletes


    

  
    
