    ,coalesce(dbt_valid_to, CAST('9999-12-31' AS DATETIME2(6))) as valid_to
    ,case when dbt_valid_to is null then 1 else 0 end as is_current
FROM [dw_oysterlake].[dbo].[snap_silver_debit_cards]

    

  
  
