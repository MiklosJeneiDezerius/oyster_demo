        CREATE TABLE [dw_oysterlake].[dbo_silver].[silver_dim_customers__dbt_tmp]
        
        AS SELECT 
    
    lower(convert(varchar(50), hashbytes('md5', coalesce(convert(varchar(max), coalesce(cast(CustomerID as VARCHAR(MAX)), '_dbt_utils_surrogate_key_null_')), '')), 2))
 as customer_sk -- Fix: Explicitly prepend dbt_utils.
