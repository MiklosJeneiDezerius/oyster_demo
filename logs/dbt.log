        CREATE TABLE [dw_oysterlake].[dbo_gold].[analytics_customer_risk_profile__dbt_tmp]
        
        AS 
with customer_info as (
    select * from [dw_oysterlake].[dbo_gold].[gold_dim_customers]
), 
      metrics as (
    select 
        account_id, 
        count(transaction_id) as total_approved_tx, 
        sum(transaction_amount) as total_spent_amount
    from [dw_oysterlake].[dbo_gold].[gold_fct_card_transactions]
    where transaction_status = 'Approved'
    group by account_id 
)
select 
    c.customer_id, 
    c.FirstName + ' ' + c.LastName as full_name, 
    c.customer_type, 
    c.account_number, 
    coalesce(m.total_approved_tx, 0) as total_transactions, 
    coalesce(m.total_spent_amount, 0.00) as total_spent
from customer_info c left join metrics m on c.account_id = m.account_id

    

  
  
