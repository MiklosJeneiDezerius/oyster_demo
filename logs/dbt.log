        CREATE TABLE [dw_oysterlake].[dbo_silver].[silver_dim_date__dbt_tmp]
        
        AS 

;with date_spine as (
    -- The date_spine macro under the hood uses an ORDER BY that breaks SQL Server views/CTEs.
    -- Wrapping it or using dbt-sqlserver specific packages handles the syntax natively.
    select top 100 percent * from (
        





with rawdata as (

    

    

    with p as (
        select 0 as generated_number union all select 1
    ), unioned as (

    select

    
    p0.generated_number * power(2, 0)
     + 
    
    p1.generated_number * power(2, 1)
     + 
    
    p2.generated_number * power(2, 2)
     + 
    
    p3.generated_number * power(2, 3)
     + 
    
    p4.generated_number * power(2, 4)
     + 
    
    p5.generated_number * power(2, 5)
     + 
    
    p6.generated_number * power(2, 6)
     + 
    
    p7.generated_number * power(2, 7)
     + 
    
    p8.generated_number * power(2, 8)
     + 
    
    p9.generated_number * power(2, 9)
     + 
    
    p10.generated_number * power(2, 10)
     + 
    
    p11.generated_number * power(2, 11)
    
    
    + 1
    as generated_number

    from

    
    p as p0
     cross join 
    
    p as p1
     cross join 
    
    p as p2
     cross join 
    
    p as p3
     cross join 
    
    p as p4
     cross join 
    
    p as p5
     cross join 
    
    p as p6
     cross join 
    
    p as p7
     cross join 
    
    p as p8
     cross join 
    
    p as p9
     cross join 
    
    p as p10
     cross join 
    
    p as p11
    
    

    )

    select *
    from unioned
    where generated_number <= 4017
    order by generated_number



),

all_periods as (

    select (
        

    dateadd(
        day,
        row_number() over (order by 1) - 1,
        cast(cast('2020-01-01' as date) as datetime2(6))
        )


    ) as date_day
    from rawdata

),

filtered as (

    select *
    from all_periods
    where date_day <= cast('2030-12-31' as date)

)

select * from filtered


    ) as sub_spine
),
renamed as (
    select cast(date_day as date) as date_day from date_spine
)
select
    date_day as date_actual,
    -- Fixed SQL Server syntax for formatting, extraction, string concatenation, and day of week
    cast(format(date_day, 'yyyyMMdd') as integer) as date_key,
    year(date_day) as year_number,
    'CY ' + cast(year(date_day) as varchar(4)) as year_name,
    datepart(quarter, date_day) as quarter_number,
    'Q' + cast(datepart(quarter, date_day) as varchar(1)) as quarter_name,
    month(date_day) as month_number,
    format(date_day, 'MMMM') as month_name,
    datepart(week, date_day) as week_of_year,
    -- datepart(dw) returns 1 (Sunday) through 7 (Saturday) in SQL Server by default
    case when datepart(dw, date_day) in (1, 7) then 1 else 0 end as is_weekend
from renamed

    

  
  
